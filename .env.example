# spec-oracle local development secret.
#
# Copy this file to `.env` (git-ignored) and change the value:
#     cp .env.example .env
#
# This single value feeds BOTH sides of the local setup:
#   * the ArangoDB container — compose maps it into ARANGO_ROOT_PASSWORD, which
#     sets the root password the FIRST time the data volume is created;
#   * the `specd` daemon — it reads ARANGODB_PASSWORD to authenticate to
#     ArangoDB. (The `spec` CLI never touches the database; it talks to the daemon.)
#
# `docker compose` auto-loads .env for the container. The daemon runs on the host,
# so export the same value into your shell before running it:
#     set -a; . ./.env; set +a
ARANGODB_PASSWORD=change-me-local-dev

# Local OpenTelemetry export. `spec` and `specd` set stable service names
# in code unless OTEL_SERVICE_NAME is explicitly supplied.
OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.10.4:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev,service.namespace=spec-oracle
# Capture policy for spec-oracle domain attributes:
#   ops        = durations/counts/stages and broad error category only
#   diagnostic = parser/error kinds, stable hashes
#   content    = diagnostic plus raw statements/content-bearing values
SPEC_ORACLE_TELEMETRY_CAPTURE=content
