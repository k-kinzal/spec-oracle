{
  "name": "spec-oracle-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Graph visualization for the spec-oracle specification graph.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "analyze:layout": "node --import tsx scripts/evaluate-layout.ts",
    "evaluate:layout:candidate": "node --import tsx scripts/evaluate-candidate.ts",
    "measure:layout:browser": "node scripts/measure-layout-browser.mjs",
    "render:layout:candidate": "node --import tsx scripts/render-candidate-svg.ts",
    "diagnose:layout:synthetic": "node --import tsx scripts/validate-layout.ts",
    "diagnose:layout:baseline": "node --import tsx scripts/validate-layout.ts --candidate=failed-baseline --suite=smoke"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13",
    "d3-force-3d": "^3.0.6",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.1",
    "tsx": "^4.23.1",
    "typescript": "^5.5.3"
  }
}
