# spec-oracle UI configuration (copy to .env.local).
#
# The UI's server layer (a Next.js Route Handler) is a thin backend-for-frontend
# that speaks gRPC to specd. The browser never talks gRPC directly.

# Address of the specd gRPC server (host:port, NO scheme — grpc-js dials it
# directly over HTTP/2).
SPEC_ORACLE_GRPC_ADDR=127.0.0.1:50051

# Directory that holds the spec_oracle.v1 .proto (the single source of truth for
# the wire contract, shared with the Rust crates). Defaults to ../so_protocol/proto
# resolved from the UI project root, so this normally needs no override.
# SPEC_ORACLE_PROTO_DIR=/absolute/path/to/so_protocol/proto
